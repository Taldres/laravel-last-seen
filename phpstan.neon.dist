includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - src
        - config
        - database
        # Analyses the LastSeen trait in the context of a model that uses it.
        - tests/TestModels
    # The migration is published as a .stub file.
    fileExtensions:
        - php
        - stub
    level: 10
    configDirectories:
        - config
    checkOctaneCompatibility: true
    checkModelProperties: true
    ignoreErrors:
        - '#^Class App\\Models\\User not found.#'
