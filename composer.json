{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "taldres/laravel-last-seen",
  "description": "Track when users were last active in your Laravel application, with a middleware, query scope and facade.",
  "keywords": [
    "laravel",
    "last-seen",
    "online-status",
    "user-activity",
    "presence",
    "middleware"
  ],
  "homepage": "https://github.com/Taldres/laravel-last-seen",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Dennis Petersmann",
      "email": "dennis@petersmann.dev",
      "homepage": "https://github.com/Taldres",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/Taldres/laravel-last-seen/issues",
    "source": "https://github.com/Taldres/laravel-last-seen",
    "security": "https://github.com/Taldres/laravel-last-seen/security/policy"
  },
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.0|^13.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.6.0",
    "laravel/pint": "^1.24.0",
    "orchestra/testbench": "^10.0|^11.0",
    "pestphp/pest": "^3.8.2|^4.0",
    "pestphp/pest-plugin-type-coverage": "^3.6|^4.0",
    "symfony/yaml": "^7.2|^8.0"
  },
  "autoload": {
    "psr-4": {
      "Taldres\\LastSeen\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Taldres\\LastSeen\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Taldres\\LastSeen\\LastSeenServiceProvider"
      ],
      "aliases": {
        "LastSeen": "Taldres\\LastSeen\\Facades\\LastSeen"
      }
    }
  },
  "config": {
    "sort-packages": true,
    "preferred-install": "dist",
    "optimize-autoloader": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "larastan/larastan": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "lint": [
      "vendor/bin/pint --parallel"
    ],
    "lint:check": [
      "vendor/bin/pint --parallel --test"
    ],
    "analyse": [
      "vendor/bin/phpstan analyse --memory-limit=2G"
    ],
    "test:types": [
      "@php -d memory_limit=2G vendor/bin/pest --type-coverage --min=100"
    ],
    "test:unit": [
      "vendor/bin/pest"
    ],
    "test": [
      "@analyse",
      "@lint:check",
      "@test:types",
      "@test:unit"
    ]
  }
}
