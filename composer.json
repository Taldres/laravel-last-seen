{
  "name": "taldres/laravel-last-seen",
  "description": "Laravel package to track user's last seen status.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Dennis Petersmann",
      "email": "hey@taldres.dev"
    }
  ],
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.0|^13.0"
  },
  "autoload": {
    "psr-4": {
      "Taldres\\LastSeen\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Taldres\\LastSeen\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Taldres\\LastSeen\\LastSeenServiceProvider"
      ]
    }
  },
  "require-dev": {
    "larastan/larastan": "^3.6.0",
    "laravel/pint": "^1.24.0",
    "orchestra/testbench": "^10.0|^11.0",
    "pestphp/pest": "^3.8.2|^4.0",
    "pestphp/pest-plugin-type-coverage": "^3.6|^4.0"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "preferred-install": "dist",
    "optimize-autoloader": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "larastan/larastan": true
    }
  },
  "scripts": {
    "lint": [
      "vendor/bin/pint --parallel"
    ],
    "lint:check": [
      "vendor/bin/pint --parallel --test"
    ],
    "analyse": [
      "vendor/bin/phpstan analyse --memory-limit=2G"
    ],
    "test:types": [
      "@php -d memory_limit=2G vendor/bin/pest --type-coverage --min=100"
    ],
    "test:unit": [
      "vendor/bin/pest"
    ],
    "test": [
      "@analyse",
      "@lint:check",
      "@test:types",
      "@test:unit"
    ]
  }
}
